{
  "description": "Cortex Code plugin hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/router/discover_cortex.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/router/prompt_filter.py\""
          }
        ]
      }
    ]
  }
}
