# Cortex Agent App — Environment Variables
# Copy to .env.local and fill in your values.

# Snowflake connection (option A: direct credentials)
SNOWFLAKE_HOST=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Snowflake connection (option B: use connections.toml)
# Set this instead of the above. Reads from ~/.snowflake/connections.toml.
# SNOWFLAKE_CONNECTION_NAME=my_connection
